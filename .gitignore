# Arquivos de dados grandes - excluídos do Git
# Ignora todos os .txt dentro de Extracoes (qualquer subpasta/ano)
Extracoes/**/*.txt
KE5Z/**/*.txt

# Também ignora na pasta dist
dist/**/Extracoes/**/*.txt
dist/**/KE5Z/**/*.txt

